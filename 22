[System.Windows.Forms.Application]::EnableVisualStyles()
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$form = New-Object System.Windows.Forms.Form
$form.FormBorderStyle = 'None'
$form.WindowState = 'Maximized'
$form.TopMost = $true
$form.BackColor = [System.Drawing.Color]::Black
$form.StartPosition = 'Manual'
$form.Bounds = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds

$rtb = New-Object System.Windows.Forms.RichTextBox
$rtb.Dock = 'Fill'
$rtb.BackColor = [System.Drawing.Color]::Black
$rtb.ForeColor = [System.Drawing.Color]::Magenta
$rtb.Font = New-Object System.Drawing.Font("Consolas", 16, [System.Drawing.FontStyle]::Bold)
$rtb.BorderStyle = 'None'
$rtb.ReadOnly = $true
$rtb.ScrollBars = 'None'
$form.Controls.Add($rtb)

$fakeCode = @(
    "Connecting to remote server...",
    "Bypassing firewall... OK",
    "Injecting payload into memory...",
    "0x7FFA2C4F: MOV EAX, [EBX+ECX*4]",
    "Encrypting C:\Users\Documents...",
    "Encrypting C:\Users\Pictures...",
    "Encrypting C:\Users\Desktop...",
    "File system locked.",
    "Waiting for ransom payment..."
)

$script:lineIndex = 0
$timerCode = New-Object System.Windows.Forms.Timer
$timerCode.Interval = 50 # Скорость печати (было 200, стало 50)

$timerCode.Add_Tick({
    if ($script:lineIndex -lt $fakeCode.Count) {
        $rtb.AppendText($fakeCode[$script:lineIndex] + "`n")
        $rtb.ScrollToCaret()
        $script:lineIndex++
    } else {
        $timerCode.Stop()
        $rtb.Visible = $false
        
        # Мгновенно меняем фон на розовый (цвет текста)
        $form.BackColor = [System.Drawing.Color]::Magenta
        
        # Пиксельный череп
        $skull = @"
             ▄▄▄▄▄▄▄▄▄
           ▄███████████▄
          ███████████████
          ███▀▀       ▀▀███
          ██   ▄     ▄   ██
          ██  ███   ███  ██
          ██   ▀     ▀   ██
          ████▄       ▄████
           ████   ▀   ████
            ████     ████
             ████▄ ▄████
              ▀███████▀
"@
        
        $lbl = New-Object System.Windows.Forms.Label
        $lbl.Text = "$skull`n`nSYSTEM INFECTED. FILES ENCRYPTED.`nKey download: 10s"
        $lbl.Font = New-Object System.Drawing.Font("Consolas", 20, [System.Drawing.FontStyle]::Bold)
        $lbl.ForeColor = [System.Drawing.Color]::Black # Черный текст на розовом фоне
        $lbl.BackColor = [System.Drawing.Color]::Transparent
        $lbl.AutoSize = $true
        $form.Controls.Add($lbl)
        
        $lbl.Left = ($form.Width - $lbl.Width) / 2
        $lbl.Top = ($form.Height - $lbl.Height) / 2
        
        $script:count = 10
        $timerCountdown = New-Object System.Windows.Forms.Timer
        $timerCountdown.Interval = 1000
        $script:timerCountdown = $timerCountdown
        $script:lbl = $lbl
        $script:skullText = $skull
        
        $timerCountdown.Add_Tick({
            $script:count--
            if ($script:count -le 0) {
                $script:timerCountdown.Stop()
                $script:lbl.Text = "$($script:skullText)`n`nJOKE! :) NOTHING IS ENCRYPTED."
                $script:lbl.ForeColor = [System.Drawing.Color]::White # Белый текст для контраста
                
                $script:timerClose = New-Object System.Windows.Forms.Timer
                $script:timerClose.Interval = 3000
                $script:timerClose.Add_Tick({
                    $script:timerClose.Stop()
                    $form.Close()
                })
                $script:timerClose.Start()
            } else {
                $script:lbl.Text = "$($script:skullText)`n`nSYSTEM INFECTED. FILES ENCRYPTED.`nKey download: $($script:count)s"
            }
        })
        $timerCountdown.Start()
    }
})

$form.Add_Shown({
    $timerCode.Start()
})

[void]$form.ShowDialog()
