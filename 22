# Загружаем графическую библиотеку
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

# Создаем окно, которое сразу на весь экран
$form = New-Object System.Windows.Forms.Form
$form.FormBorderStyle = 'None' # Без рамок
$form.WindowState = 'Maximized' # Сразу на весь экран
$form.BackColor = [System.Drawing.Color]::Black
$form.TopMost = $true # Поверх всех окон
$form.KeyPreview = $true

# Создаем текст (имитация консоли)
$label = New-Object System.Windows.Forms.Label
$label.Text = "SYSTEM LOCKED`n`nENTER CODE:"
$label.Font = New-Object System.Drawing.Font("Consolas", 24, [System.Drawing.FontStyle]::Bold)
$label.ForeColor = [System.Drawing.Color]::Red
$label.BackColor = [System.Drawing.Color]::Black
$label.AutoSize = $true
$label.Anchor = 'None'
$form.Controls.Add($label)

# Текстовое поле для ввода кода (скрытое с виду, чтобы выглядело как консоль)
$textBox = New-Object System.Windows.Forms.TextBox
$textBox.Font = New-Object System.Drawing.Font("Consolas", 24, [System.Drawing.FontStyle]::Bold)
$textBox.ForeColor = [System.Drawing.Color]::Red
$textBox.BackColor = [System.Drawing.Color]::Black
$textBox.BorderStyle = 'None'
$textBox.Width = 300
$textBox.PasswordChar = '*' # Скрываем ввод
$form.Controls.Add($textBox)

# Центрируем текст при открытии
$form.Add_Shown({
    $label.Location = New-Object System.Drawing.Point(($form.ClientSize.Width - $label.Width) / 2, ($form.ClientSize.Height / 2) - 100)
    $textBox.Location = New-Object System.Drawing.Point(($form.ClientSize.Width - $textBox.Width) / 2, ($form.ClientSize.Height / 2) + 50)
    $textBox.Focus()
})

# Обработка нажатия Enter
$textBox.Add_KeyDown({
    if ($_.KeyCode -eq 'Enter') {
        if ($textBox.Text -eq '123') {
            $form.Close()
        } else {
            $textBox.Text = ''
            $label.Text = "ACCESS DENIED`n`nENTER CODE:"
            $label.ForeColor = [System.Drawing.Color]::White
            $label.BackColor = [System.Drawing.Color]::Red
            Start-Sleep -Milliseconds 500
            $label.ForeColor = [System.Drawing.Color]::Red
            $label.BackColor = [System.Drawing.Color]::Black
        }
    }
})

# Блокируем Alt+F4 и другие закрытия (кроме нашего кода)
$form.Add_FormClosing({
    if ($textBox.Text -ne '123') {
        $_.Cancel = $true
    }
})

# Запускаем окно
[void]$form.ShowDialog()
