# Встраиваем C# код для создания полноценного приложения
$code = @"
using System;
using System.Drawing;
using System.Windows.Forms;
using System.Runtime.InteropServices;

public class FullScreenLock : Form
{
    [DllImport("user32.dll")]
    public static extern bool BlockInput(bool fBlockIt);

    private TextBox txt;
    private Label lbl;

    public FullScreenLock()
    {
        // Настройка окна: без рамок, черный фон, на весь экран
        this.FormBorderStyle = FormBorderStyle.None;
        this.WindowState = FormWindowState.Maximized;
        this.TopMost = true;
        this.BackColor = Color.Black;
        this.KeyPreview = true;

        // Текст заголовка
        lbl = new Label();
        lbl.Text = "SYSTEM LOCKED\n\nENTER PASSWORD:";
        lbl.Font = new Font("Consolas", 32, FontStyle.Bold);
        lbl.ForeColor = Color.Red;
        lbl.AutoSize = true;
        this.Controls.Add(lbl);

        // Поле ввода
        txt = new TextBox();
        txt.Font = new Font("Consolas", 32, FontStyle.Bold);
        txt.ForeColor = Color.Red;
        txt.BackColor = Color.Black;
        txt.BorderStyle = BorderStyle.None;
        txt.PasswordChar = '*';
        txt.Width = 400;
        this.Controls.Add(txt);

        // Центрируем элементы
        this.Load += (s, e) => {
            lbl.Location = new Point((this.Width - lbl.Width) / 2, (this.Height / 2) - 150);
            txt.Location = new Point((this.Width - txt.Width) / 2, (this.Height / 2) + 50);
            txt.Focus();
            BlockInput(true); // Блокируем клавиатуру и мышь системы (кроме нашего окна)
        };

        // Обработка ввода
        txt.KeyDown += (s, e) => {
            if (e.KeyCode == Keys.Enter)
            {
                if (txt.Text == "123")
                {
                    BlockInput(false); // Разблокируем систему
                    Application.Exit(); // Закрываем программу
                }
                else
                {
                    txt.Clear();
                    lbl.Text = "ACCESS DENIED\n\nENTER PASSWORD:";
                    lbl.ForeColor = Color.White;
                    lbl.BackColor = Color.Red;
                    Timer t = new Timer();
                    t.Interval = 500;
                    t.Tick += (s2, e2) => {
                        lbl.ForeColor = Color.Red;
                        lbl.BackColor = Color.Black;
                        t.Stop();
                    };
                    t.Start();
                }
            }
        };

        // Запрет закрытия через Alt+F4
        this.FormClosing += (s, e) => {
            if (txt.Text != "123") e.Cancel = true;
        };
    }
}
"@

# Компилируем и запускаем
Add-Type -TypeDefinition $code -ReferencedAssemblies System.Windows.Forms, System.Drawing
[FullScreenLock]::new().ShowDialog()
